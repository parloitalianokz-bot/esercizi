<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lavagna Condivisa Live 🎨</title>
    <style>
        :root {
            --primary: #4CAF50;
            --accent: #f44336;
            --bg: #2d3748;
            --panel-bg: #1a202c;
        }
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background: var(--bg); 
            margin: 0; 
            padding: 0; 
            overflow: hidden; 
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        /* Barra degli strumenti superiore */
        .toolbar {
            background: var(--panel-bg);
            padding: 10px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            color: white;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
            z-index: 10;
        }
        .toolbar h1 {
            font-size: 1.2rem;
            margin: 0;
            margin-right: 20px;
            color: #e2e8f0;
        }
        .tool-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        label {
            font-size: 0.9rem;
            color: #cbd5e0;
        }
        input[type="color"] {
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            background: none;
        }
        select, button {
            padding: 8px 12px;
            font-size: 14px;
            border-radius: 6px;
            border: 1px solid #4a5568;
            background: #2d3748;
            color: white;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
        }
        select:focus, button:focus {
            outline: none;
            border-color: var(--primary);
        }
        button:hover {
            background: #4a5568;
        }
        .btn-clear {
            background: var(--accent);
            border-color: var(--accent);
        }
        .btn-clear:hover {
            background: #d32f2f;
        }
        /* Contenitore Lavagna */
        .canvas-container {
            flex: 1;
            position: relative;
            background: #ffffff;
            cursor: crosshair;
        }
        canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: block;
        }
    </style>
</head>
<body>

<div class="toolbar">
    <h1>🎨 Lavagna di Classe Live</h1>
    
    <div class="tool-group">
        <label for="colorPicker">Colore:</label>
        <input type="color" id="colorPicker" value="#4CAF50">
    </div>

    <div class="tool-group">
        <label for="sizePicker">Tratto:</label>
        <select id="sizePicker">
            <option value="2">Sottile</option>
            <option value="5" selected>Medio</option>
            <option value="10">Spesso</option>
            <option value="20">Evidenziatore</option>
        </select>
    </div>

    <div class="tool-group" style="margin-left: 20px;">
        <button class="btn-clear" onclick="clearBoard()">Cancella Tutto 🧹</button>
    </div>
</div>

<div class="canvas-container" id="canvasContainer">
    <canvas id="paintCanvas"></canvas>
</div>

